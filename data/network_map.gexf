<edge id="V0105" source="person|ze'ev jabotinsky" target="org|irgun" label="officer/executive"><attvalues><attvalue for="0" value="officer/executive"/><attvalue for="1" value="verified"/><attvalue for="2" value='{"verified": 1}'/><attvalue for="3" value="vault screenshot/note"/><attvalue for="4" value="founded"/><attvalue for="5" value="1"/><attvalue for="6" value="[{&quot;id&quot;: &quot;C0113&quot;, &quot;status&quot;: &quot;verified&quot;, &quot;role&quot;: &quot;founded&quot;, &quot;snippet&quot;: &quot;The Irgun policy was based on what was then called Revisionist Zionism founded by Ze'ev Jabotinsky.&quot;, &quot;source_file&quot;: &quot;Pasted image 20250706110211.png&quot;, &quot;source_kind&quot;: &quot;screenshot&quot;, &quot;ocr_note&quot;: &quot;Network Map/OCR/OCR - Pasted image 20250706110211.md&quot;}]"/></attvalues><viz:color r="46" g="157" b="79"/></edge>
